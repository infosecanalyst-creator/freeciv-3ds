+/* 3DS: implemented in 3ds_port/source/game_loop.c. Drains player-input
+ * actions (e.g. queued unit moves) queued from the client's render/input
+ * thread - see the call site below. */
+extern void freeciv3ds_process_pending_actions(void);
+
+/* 3DS: cooperative-scheduling yield/park point, implemented in
+ * 3ds_port/source/fc3ds_server.c. Parks the server thread (zero CPU) iff
+ * server_state()==S_S_RUNNING; returns immediately otherwise, so setup/
+ * pregame/postgame/quit all run through ungated exactly as before. See
+ * handoff.md sec5.2 - verified on New3DS hardware (HOME during idle/
+ * mid-turn/map-gen, 30+ turn sessions, clean quit) 2026-07-10. */
+#ifdef __3DS__
+extern void fc3ds_server_yield(void);
+#endif
