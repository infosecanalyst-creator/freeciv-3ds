       return S_E_FORCE_END_OF_SNIFF;
     }
 
+#ifdef __3DS__
+    /* Cooperative-scheduling park point: blocks (zero CPU) only during the
+     * interactive S_S_RUNNING turn loop, until the main render loop signals
+     * a step. See fc3ds_server_yield(). */
+    fc3ds_server_yield();
+#endif
+
+    /* 3DS: drain any unit-move (etc) request queued by the client's input
+     * thread. This is the only safe point to apply it - it's the same loop
+     * that already owns all game-state mutation, polled once per iteration
+     * just like force_end_of_sniff above. See 3ds_port/source/game_loop.c. */
+    freeciv3ds_process_pending_actions();
+
